# Fastfile
default_platform(:android)

# Small speed/cleanliness improvements
ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "true"
ENV["FASTLANE_HIDE_CHANGELOG"] = "true"

platform :android do
  desc "Distribute existing CI-built APK (no build inside Fastlane)"
  lane :distribute_ci do |options|
    test_email    = options[:test_email]
    release_notes = options[:release_notes].to_s

    apk_path = options[:apk_path].to_s.strip
    apk_path = "../build/app/outputs/flutter-apk/app-release.apk" if apk_path.empty?

    UI.message("Using APK path: #{apk_path}")

    unless File.exist?(apk_path)
      UI.user_error!("APK not found at #{apk_path}. CI build step must produce it before running Fastlane.")
    end

    # Optional: show size quickly
    begin
      size_mb = (File.size(apk_path).to_f / (1024 * 1024)).round(2)
      UI.message("APK size: #{size_mb} MB")
    rescue
      # ignore
    end

    firebase_args = {
      app: "1:419893562273:android:5d15901a1b38730eb659e0",
      firebase_cli_token: ENV["FIREBASE_TOKEN"],
      release_notes: release_notes,
      groups: "nawah-team",
      apk_path: apk_path
    }

    # Add testers only if email is provided and not the default placeholder
    if test_email && !test_email.to_s.strip.empty? && test_email != "Enter the client email..."
      firebase_args[:testers] = test_email
    end

    firebase_app_distribution(**firebase_args)

    UI.success("✅ Firebase distribution done.")
  end
end
