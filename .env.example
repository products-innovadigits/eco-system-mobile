# Copy this file to .env and fill in the values for local development.
# Alternatively, export these as system environment variables before running build_runner.
#
# IMPORTANT: Never commit the .env file to git.

DOMAIN_DEV=
DOMAIN_PRO=
BASE_URL_PRO=
BASE_URL_DEV=
# Base URLs must end with trailing slash (e.g. https://api.example.com/v1/)
STRATEGY_BASE_URL_DEV=
AUTH_BASE_URL_DEV=
ATS_BASE_URL_DEV=
PMS_BASE_URL_DEV=
# Project Management API (e.g. https://194.163.168.5:447/api/)
PROJECT_MANAGEMENT_BASE_URL_DEV=
# Project AI POST …/projects/query
# Local default: http://127.0.0.1:8000/projects/query
# Physical device: run `cloudflared tunnel --url http://127.0.0.1:8000` then:
# flutter run --dart-define=PROJECT_AI_BASE_URL=https://your-subdomain.trycloudflare.com/
PROJECT_AI_BASE_URL_DEV=
GOOGLE_MAPS_BASE_URL=
SHARED_PREFERENCES_NAME=
API_KEY=
