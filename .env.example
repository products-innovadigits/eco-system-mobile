# Copy this file to .env and fill in the values for local development.
# Alternatively, export these as system environment variables before running build_runner.
#
# IMPORTANT: Never commit the .env file to git.

DOMAIN_DEV=
DOMAIN_PRO=
BASE_URL_PRO=
BASE_URL_DEV=
# Base URLs must end with trailing slash (e.g. https://api.example.com/v1/)
# Strategy and Project Management are served by the same backend, so these two
# normally hold the same value (e.g. https://api-src.nawahtech.com/api/).
STRATEGY_BASE_URL_DEV=
AUTH_BASE_URL_DEV=
ATS_BASE_URL_DEV=
# PMS API (e.g. https://pms-dev.nawahtech.com/api/v1/) — login lives at <base>login
PMS_BASE_URL_DEV=
# Project Management API — see STRATEGY_BASE_URL_DEV above.
PROJECT_MANAGEMENT_BASE_URL_DEV=
# AI assistant POST …/projects/query: base URL is hardcoded in systems/project_management/.../ai_assistant_repo_impl.dart (not .env).
GOOGLE_MAPS_BASE_URL=
SHARED_PREFERENCES_NAME=
API_KEY=
